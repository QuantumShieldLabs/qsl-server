# Example reverse-proxy configuration for qsl-server.
# Keep qsl-server bound to loopback (127.0.0.1:8080) and expose public TLS here.

relay.example.com {
    encode gzip

    # Keep /v1 request logging disabled/sanitized during the compatibility
    # window. Canonical clients use X-QSL-Route-Token, but legacy path-based
    # clients may still place route tokens in the request URI until removal.
    @relay_api path /v1/*
    log_skip @relay_api

    reverse_proxy 127.0.0.1:8080

    handle {
        respond 404
    }
}
