# Example reverse-proxy configuration for qsl-server.
# Keep qsl-server bound to loopback (127.0.0.1:8080) and expose public TLS here.

relay.example.com {
    encode gzip

    # /v1 paths include capability-like route tokens in the URI. Do not log
    # these request URIs in access logs.
    @relay_api path /v1/*
    log_skip @relay_api

    reverse_proxy 127.0.0.1:8080

    handle {
        respond 404
    }
}
